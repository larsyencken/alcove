{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alcove config",
  "type": "object",
  "definitions": {
    "dependency": {
      "type": "string",
      "description": "Name segments use underscores; only the final version segment may contain hyphens, for ISO dates.",
      "oneOf": [
        {
          "pattern": "^snapshot://([a-z0-9_*]+/)*[a-z0-9_*-]+$"
        },
        {
          "pattern": "^table://([a-z0-9_*]+/)*[a-z0-9_*-]+$"
        },
        {
          "pattern": "^artifact://([a-z0-9_*]+/)*[a-z0-9_*-]+$"
        }
      ]
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "description": "Version of the alcove config file"
    },
    "data_dir": {
      "type": "string",
      "description": "Directory where the alcove data is stored, relative to this file.",
      "default": "data"
    },
    "steps": {
      "type": "object",
      "description": "List of available steps to run",
      "patternProperties": {
        "^snapshot://": {
          "type": "array",
          "maxItems": 0
        },
        "^table://": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/dependency"
          }
        },
        "^artifact://": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/dependency"
          }
        }
      }
    }
  }
}
