{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alcove config",
  "type": "object",
  "definitions": {
    "dependency": {
      "type": "string",
      "description": "Name segments use underscores; only the final version segment may contain hyphens, for ISO dates.",
      "oneOf": [
        {
          "pattern": "^snapshot://([a-z0-9_*]+/)*[a-z0-9_*-]+$"
        },
        {
          "pattern": "^table://([a-z0-9_*]+/)*[a-z0-9_*-]+$"
        },
        {
          "pattern": "^artifact://([a-z0-9_*]+/)*[a-z0-9_*-]+$"
        }
      ]
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "description": "Version of the alcove config file"
    },
    "data_dir": {
      "type": "string",
      "description": "Directory where the alcove data is stored, relative to this file.",
      "default": "data"
    },
    "storage": {
      "description": "Where snapshot data is kept. Defaults to s3.",
      "oneOf": [
        {
          "enum": ["s3", "local", "git"]
        },
        {
          "type": "object",
          "properties": {
            "backend": {
              "enum": ["s3", "local", "git"]
            },
            "path": {
              "type": "string",
              "description": "For local storage, the directory blobs are kept in, relative to this file."
            }
          },
          "required": ["backend"],
          "additionalProperties": false
        }
      ]
    },
    "steps": {
      "type": "object",
      "description": "List of available steps to run",
      "additionalProperties": false,
      "patternProperties": {
        "^snapshot://([a-z0-9_*]+/)*[a-z0-9_*-]+$": {
          "type": "array",
          "maxItems": 0
        },
        "^table://([a-z0-9_*]+/)*[a-z0-9_*-]+$": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/dependency"
          }
        },
        "^artifact://([a-z0-9_*]+/)*[a-z0-9_*-]+$": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/dependency"
          }
        }
      }
    }
  }
}
